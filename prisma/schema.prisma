// Prisma schema -- Sprint 1 minimal scope
// Tables: Users (with authentication fields merged in), Sessions
// Decision (within backend-core's own authority): UserAuthentication is merged
// into Users for Sprint 1 to avoid a premature 1:1 join; documented in README
// under "Design Decisions". Can be split into its own table later without
// breaking the API contract if the auth data grows (e.g. multiple auth
// providers, refresh tokens table, etc.)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SessionState {
  S1_initial_state
  S2_collecting_information
  S3_assign_urgency
  S4_ai_triage_processing
  S5_pending_doctor_review
  S6_marked_emergency
  S7_marked_home_treatment
  S8_marked_normal
  S9_completed_triage
  S10_cancelled_by_user
}

// RBAC (2026-07-21): patient/doctor/admin. Renamed from the old
// patient/staff pair via ALTER TYPE ... RENAME VALUE in the migration,
// so existing staff accounts become doctor accounts automatically.
enum UserRole {
  patient
  doctor
  admin
}

// doctorReviewStatus (2026-08-08, PM-approved, replaces two earlier
// conflicting proposals): tracks the doctor panel's review pipeline for a
// session, independent from SessionState/staffFinalizeReview.
enum DoctorReviewStatus {
  unfinished
  ai_completed
  doctor_message_sent
  visited_inperson
  appointment_scheduled
  closed_no_action
}

model User {
  id            String    @id @default(uuid())
  name          String
  nationalId    String?   @unique @map("national_id")
  phoneNumber   String?   @map("phone_number")
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          UserRole  @default(patient)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  // 2026-07-31: optional health-profile prompt, dismissible; Frontend
  // re-shows the prompt next session unless this is set.
  healthProfileReminderDismissedAt DateTime? @map("health_profile_reminder_dismissed_at")

  sessions          Session[]
  patientDetails    PatientDetails?
  historySummaries  PatientHistorySummary[]
  medicalHistory    MedicalHistory?
  periodicVitals    PeriodicVitals[]
  wallet            Wallet?
  orders            Order[]
  referralCode      ReferralCode?
  wasInvitedBy      ReferralRedemption? @relation("InvitedUser")

  @@map("users")
}

// Payment/plans (2026-08-01, PM-approved data model). Sandbox Zarinpal
// integration comes next; this model is provider-agnostic on purpose so
// swapping in the real merchant code later needs no schema change.
model Order {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  type              String    // "plan_purchase" | "topup"
  planCode          String?   @map("plan_code") // "SILVER" | "GOLD" | "DIAMOND" | null for topup
  amountToman       Int       @map("amount_toman")
  status            String    @default("pending") // "pending" | "paid" | "failed" | "cancelled"
  zarinpalAuthority String?   @unique @map("zarinpal_authority")
  zarinpalRefId     String?   @map("zarinpal_ref_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  paidAt            DateTime? @map("paid_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("orders")
  @@index([userId])
}

model ReferralCode {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  redemptions ReferralRedemption[]

  @@map("referral_codes")
}

// Only credited (creditedAt set) once the invited user completes one real
// triage -- not on signup alone -- per anti-abuse decision (2026-08-01).
model ReferralRedemption {
  id             String    @id @default(uuid())
  referralCodeId String    @map("referral_code_id")
  invitedUserId  String    @unique @map("invited_user_id")
  creditedAt     DateTime? @map("credited_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  referralCode ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  invitedUser  User         @relation("InvitedUser", fields: [invitedUserId], references: [id], onDelete: Cascade)

  @@map("referral_redemptions")
  @@index([referralCodeId])
}

// Static demographic data about the patient.
// 2026-08-01 (PM decision): birthDate is the real source of truth for age
// again -- the brief age-direct approach was reverted because the product
// requirement is "age computed from birthDate server-side", not sent raw
// by the client. `age` remains as a server-computed cache, kept in sync
// on every submit-symptoms call -- never trust it as authoritative on its
// own, always recompute from birthDate when it matters.
model PatientDetails {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  birthDate DateTime @map("birth_date")
  age       Int?     @map("age") // server-computed cache of birthDate, kept in sync
  weightKg  Float?   @map("weight_kg")
  heightCm  Float?   @map("height_cm")
  gender    String?  @map("gender")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("patient_details")
}

model Session {
  id                  String        @id @default(uuid())
  userId              String        @map("user_id")
  // 2026-08 (TASK 7, PM request): sequential visit number (101, 102, ...)
  // shown to doctors/patients as a human-friendly reference, independent
  // from the UUID id and independent from display order (list order stays
  // newest-first, unaffected by this field). Backfilled in a custom SQL
  // migration ordered by createdAt ASC, not Postgres physical row order --
  // see migration.sql for why the naive Prisma-generated approach was
  // unsafe here.
  visitNumber         Int           @unique @default(autoincrement()) @map("visit_number")
  currentState        SessionState  @default(S2_collecting_information) @map("current_state")
  // Self-attestation that this triage request is genuinely for the logged-in
  // user themself (2026-07-22, project manager decision) -- guards against
  // a family member using someone else's account. Required at session
  // creation; also logged to AuditLog for accountability if disputed later.
  confirmedSelf       Boolean       @default(false) @map("confirmed_self")
  presentingProblemId String?       @map("presenting_problem_id")
  doctorReviewStatus  DoctorReviewStatus @default(unfinished) @map("doctor_review_status")
  closedAt            DateTime?     @map("closed_at")
  cancelledAt         DateTime?     @map("cancelled_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  feedback       PatientFeedback?
  historySummary PatientHistorySummary?
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  triageResult   TriageResult?

  @@map("sessions")
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
  @@index([userId])
  @@index([entityType, entityId])
}

model ErrorLog {
  id         String   @id @default(uuid())
  code       String?
  message    String
  stack      String?
  path       String?
  method     String?
  statusCode Int?     @map("status_code")
  userId     String?  @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("error_logs")
}

model TriageResult {
  id               String   @id @default(uuid())
  sessionId        String   @unique @map("session_id")
  urgencyLevel     String   @map("urgency_level")
  triageResultJson Json     @map("triage_result_json")
  createdAt        DateTime @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("triage_results")
}

model PatientFeedback {
  id        String   @id @default(uuid())
  sessionId String   @unique @map("session_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("patient_feedback")
}

model PatientHistorySummary {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  sessionId           String   @unique @map("session_id")
  presentingProblemId String?  @map("presenting_problem_id")
  urgencyLevel        String   @map("urgency_level")
  reasoningSummary    String?  @map("reasoning_summary")
  createdAt           DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("patient_history_summaries")
  @@index([userId])
}

model MedicalHistory {
  id                 String   @id @default(uuid())
  userId             String   @unique @map("user_id")
  chronicConditions  String[] @map("chronic_conditions")
  allergies          String[] @map("allergies")
  currentMedications String[] @map("current_medications")
  surgicalHistory    String[] @map("surgical_history")
  familyHistory      String[] @map("family_history")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("medical_history")
}

model PeriodicVitals {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  type       String
  value      Json
  recordedAt DateTime @default(now()) @map("recorded_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("periodic_vitals")
  @@index([userId])
  @@index([userId, type])
}

// Wallet (2026-08-08 fix, PM-confirmed): balance in Toman, default
// 1,000,000. Each completed triage deducts 5,000. Daily limit is read
// from PLANS.FREEMIUM.dailyFreeTriages (currently 5), enforced by
// counting today's PatientHistorySummary rows -- no counter field
// needed. Source of truth for all these values is walletService.js,
// not this comment -- update here again if walletService.js changes.
model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  balance   Int      @default(1000000)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}